{
  "name": "local-data-workbench",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "test": "npm run test:unit && npm run test:rust",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:e2e": "playwright test",
    "test:bundle-notices": "sh scripts/check-bundle-notices.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.18.1",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
