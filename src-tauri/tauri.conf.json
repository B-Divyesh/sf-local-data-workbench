{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Data Workbench",
  "version": "0.1.2",
  "identifier": "in.sociobot.localdataworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Local Data Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#F2EFE6"
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.sociobot.in; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Private, reproducible local file transforms",
    "longDescription": "Inspect, profile, transform, join, and export large CSV, JSON, JSONL, and Parquet files without uploading them.",
    "copyright": "Copyright © 2026 Sociobot",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../samples/monthly-orders.csv", "../LICENSE", "../THIRD_PARTY_NOTICES.md", "../LICENSES/Apache-2.0.txt"]
  }
}
